<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="ares"
          fetch="https://github.com"
          revision="refs/heads/17.0" />

  <remote name="ares-gl"
          fetch="https://gitlab.com"
          revision="refs/heads/17.0" />

  <!-- AresOS additions -->
  <project path="manifest" name="AresOS-AOSP/manifest" remote="ares" />

  <project path="build/make" name="AresOS-AOSP/android_build" groups="pdk,sysui-studio" remote="ares" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="frameworks/base" name="AresOS-AOSP/android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="ares" />
  <project path="frameworks/libs/systemui" name="AresOS-AOSP/android_frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="ares" />
  <project path="frameworks/native" name="AresOS-AOSP/android_frameworks_native" groups="pdk,sysui-studio" remote="ares" />

  <project path="packages/apps/ElyrionSettings" name="AresOS-AOSP/android_packages_apps_ElyrionSettings" remote="ares" />
  <project path="packages/apps/GameSpace" name="AresOS-AOSP/android_packages_apps_GameSpace" remote="ares" />
  <project path="packages/apps/Launcher3" name="AresOS-AOSP/android_packages_apps_Launcher3" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="ares" />
  <project path="packages/apps/Settings" name="AresOS-AOSP/android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="ares" />

  <project path="vendor/addons" name="AresOS-AOSP/android_vendor_addons" remote="ares" />
  <project path="vendor/lineage" name="AresOS-AOSP/android_vendor_lineage" remote="ares" />
</manifest>
